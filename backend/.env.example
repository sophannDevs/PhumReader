# Copy to backend/.env (git-ignored) and fill in. Never commit real values.
# The dev profile reads this file; in other environments set real environment variables.

# Supabase project phumreader-dev, session pooler (Project Settings > Database > Connection string > Session pooler).
# Format: jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_URL=
# postgres.<project-ref>
DB_USER=
# The database password you chose when creating the project.
DB_PASSWORD=

# The website's address (links in emails, sign-in redirects).
FRONTEND_URL=http://localhost:3000

# Port of the API (the website's /api rewrite points here through BACKEND_URL).
PORT=8080

# Private key that signs sign-in tokens: RSA 2048, PKCS#8 PEM (one line with \n, or the base64 body only).
# Optional in dev: left empty, the API makes a new key at start (everyone is signed out after a restart).
# Required in prod. Make one with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
PHUMREADER_JWT_PRIVATE_KEY=

# --- Local services without Docker: `npm run services:start`, then `npm run services:check` ---
# macOS: brew install redis meilisearch minio mailpit. Windows: Memurai, meilisearch.exe, minio.exe, mailpit.exe.
# Redis: local Redis/Memurai, or an Upstash database (rediss://default:<password>@<host>:6379).
REDIS_URL=redis://127.0.0.1:6379
MEILI_URL=http://127.0.0.1:7700
MEILI_MASTER_KEY=phumreader-dev-meili-key
# Object storage: MinIO locally, Cloudflare R2 in staging and production.
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=phumreader-dev
S3_ACCESS_KEY=phumreader
S3_SECRET_KEY=phumreader-dev-secret
S3_REGION=auto
# Mail: Mailpit catches every email; open http://127.0.0.1:8025 to read them.
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAILPIT_UI_URL=http://127.0.0.1:8025

# --- Google and Facebook login (P3-04, A14). Leave empty to hide the buttons' backend: they answer "not set up". ---
# Redirect URIs to register in each console (same host as FRONTEND_URL, through the website's /api rewrite):
#   <FRONTEND_URL>/api/v1/auth/oauth/google/callback    (Google Cloud Console > Credentials > OAuth client ID, Web)
#   <FRONTEND_URL>/api/v1/auth/oauth/facebook/callback  (Meta for Developers > Facebook Login > Valid OAuth Redirect URIs)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Paid comic panels (P3-08): the image Worker in infra/image-worker checks signed addresses ---
# Leave both empty in development: panels are then served from the storage address without signing.
# Staging and production: the same secret goes into the Worker (`npx wrangler secret put SIGNING_SECRET`).
# Make one with: openssl rand -base64 48
IMAGE_SIGNING_SECRET=
# The Worker's address, e.g. https://img.phumreader.com (no trailing slash).
IMAGE_CDN_URL=
