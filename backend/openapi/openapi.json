{
  "openapi" : "3.1.0",
  "info" : {
    "description" : "Backend for PhumReader. Errors always use the ErrorResponse body.",
    "title" : "PhumReader API",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "/",
    "description" : "Same origin as the website"
  } ],
  "paths" : {
    "/api/v1/health" : {
      "get" : {
        "description" : "200 when everything is UP, 503 when the database is DOWN.",
        "operationId" : "health",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/HealthResponse"
                }
              }
            },
            "description" : "OK"
          },
          "default" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description" : "Error"
          }
        },
        "summary" : "Is the API running and can it reach the database?",
        "tags" : [ "health" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "ErrorDetail" : {
        "type" : "object",
        "properties" : {
          "code" : {
            "type" : "string",
            "example" : "validation_failed"
          },
          "fields" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "string"
            }
          },
          "message" : {
            "type" : "string"
          }
        },
        "required" : [ "code", "message" ]
      },
      "ErrorResponse" : {
        "type" : "object",
        "description" : "Body of every error response.",
        "properties" : {
          "error" : {
            "$ref" : "#/components/schemas/ErrorDetail"
          }
        },
        "required" : [ "error" ]
      },
      "HealthResponse" : {
        "type" : "object",
        "properties" : {
          "database" : {
            "type" : "string",
            "enum" : [ "UP", "DOWN" ]
          },
          "status" : {
            "type" : "string",
            "enum" : [ "UP", "DOWN" ]
          }
        },
        "required" : [ "database", "status" ]
      }
    }
  }
}
