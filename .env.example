# Copy to .env.local (git-ignored) to change these settings.

# Spring Boot API (backend/). The browser calls /api/... on this site and Next.js forwards it here.
BACKEND_URL=http://localhost:8080

# 1 = the Phase 1 demo: demo data and the local store, no backend needed.
# Unset or 0 = the real API above (start it with `cd backend && ./gradlew bootRun`).
NEXT_PUBLIC_DEMO=
